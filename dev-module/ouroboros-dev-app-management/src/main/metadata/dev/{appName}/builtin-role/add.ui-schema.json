{
  "name": "/dev/{appName}/builtin-role/add",
  "schema": {
    "type": "form",
    "mode": "horizontal",
    "api": {
      "url": "/api/dev/${appName}/builtin-role",
      "method": "post",
      "data": {
        "id": "${id}",
        "name": "${name}",
        "authorities": "${authorities | pick:authority~fullName,accessControlParams}"
      }
    },
    "body": [
      {
        "type": "input-text",
        "label": "角色标识",
        "name": "id",
        "required": true
      },
      {
        "type": "input-text",
        "label": "角色名称",
        "name": "name",
        "required": true
      },
      {
        "type": "selection-editor",
        "label": false,
        "name": "authorities",
        "primaryField": "fullName",
        "source": {
          "url": "/api/dev/${appName}/builtin-role/authority-define-tree",
          "method": "get"
        },
        "value": [],
        "columns": [
          {
            "label": "权限",
            "name": "title"
          }
        ],
        "selectedData": {
          "fullName": "$fullName",
          "accessControlParams": "${accessControlParams || {}}"
        },
        "editColumnProps": {
          "label": "数据权限"
        },
        "editButtonProps": {
          "level": "primary",
          "label": "配置数据权限",
          "visibleOn": "this.accessControlSettingSchema && this.accessControlSettingSchema.length"
        },
        "editDialogProps": {
          "size": "md",
          "title": "配置数据权限"
        },
        "editFormItems": [
          {
            "type": "amis-schema",
            "source": "${accessControlSettingSchema}"
          }
        ]
      }
    ],
    "onEvent": {
      "submitSucc": {
        "actions": [
          {
            "actionType": "closeDialog"
          },
          {
            "actionType": "reload",
            "componentName": "builtin-role-list"
          }
        ]
      }
    },
    "actions": [
      {
        "type": "button",
        "label": "关闭",
        "actionType": "close"
      },
      {
        "type": "button",
        "label": "保存",
        "actionType": "confirm",
        "level": "primary",
        "primary": true
      }
    ],
    "wrapWithPanel": false
  }
}
