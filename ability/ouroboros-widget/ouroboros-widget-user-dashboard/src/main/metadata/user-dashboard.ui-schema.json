{
  "name": "/user-dashboard",
  "schema": {
    "type": "page",
    "body": [
      {
        "type": "form",
        "wrapWithPanel": false,
        "api": {
          "method": "post",
          "url": "/api/user-dashboard/save"
        },
        "initApi": {
          "method": "get",
          "url": "/api/user-dashboard/init"
        },
        "body": [
          {
            "type": "dashboard",
            "name": "dashboard",
            "placeholderImage": {
              "className": "user-dashboard-empty-state__art"
            },
            "editablePlaceholder": {
              "type": "container",
              "className": "user-dashboard-empty-state",
              "body": [
                {
                  "type": "tpl",
                  "tpl": "<div class=\"user-dashboard-empty-state__title\">从这里开始布置你的个人门户</div>"
                },
                {
                  "type": "tpl",
                  "tpl": "<div class=\"user-dashboard-empty-state__description\">插入常用栏目，把待办、快捷入口和统计信息排到你顺手的位置。</div>"
                },
                {
                  "type": "button",
                  "label": "开始编辑",
                  "level": "primary",
                  "actionType": "dashboard-edit-mode"
                }
              ]
            },
            "editablePlaceholderIndicator": {
              "src": "data:image/svg+xml,%3Csvg%20xmlns%3D%22http%3A%2F%2Fwww.w3.org%2F2000%2Fsvg%22%20width%3D%22224%22%20height%3D%22124%22%20viewBox%3D%22-18%200%20242%20124%22%20fill%3D%22none%22%3E%3Cdefs%3E%3Cmarker%20id%3D%22tailArrow%22%20markerWidth%3D%228%22%20markerHeight%3D%228%22%20viewBox%3D%220%200%208%208%22%20refX%3D%227%22%20refY%3D%224%22%20orient%3D%22auto%22%20markerUnits%3D%22strokeWidth%22%3E%3Cpath%20d%3D%22M1.2%201.2L7%204L1.2%206.8%22%20stroke%3D%22%23B8C0CA%22%20stroke-width%3D%221.45%22%20stroke-linecap%3D%22round%22%20stroke-linejoin%3D%22round%22%20fill%3D%22none%22%2F%3E%3C%2Fmarker%3E%3C%2Fdefs%3E%3Ctext%20x%3D%22-12%22%20y%3D%2273%22%20fill%3D%22%23A8B0BA%22%20font-family%3D%22'PingFang%20SC'%2C'Microsoft%20YaHei'%2Csans-serif%22%20font-size%3D%2213%22%3E%E6%82%AC%E5%81%9C%E5%8F%B3%E4%B8%8A%E8%A7%92%EF%BC%8C%E4%BC%9A%E5%87%BA%E7%8E%B0%3C%2Ftext%3E%3Ctext%20x%3D%22-12%22%20y%3D%2291%22%20fill%3D%22%23A8B0BA%22%20font-family%3D%22'PingFang%20SC'%2C'Microsoft%20YaHei'%2Csans-serif%22%20font-size%3D%2213%22%3E%E3%80%8C%E5%BC%80%E5%A7%8B%E7%BC%96%E8%BE%91%E3%80%8D%E5%85%A5%E5%8F%A3%3C%2Ftext%3E%3Cpath%20d%3D%22M114%2080C134%2079%20151%2074%20167%2064C181%2055%20190%2033%20206%2017%22%20stroke%3D%22%23B8C0CA%22%20stroke-width%3D%221.625%22%20stroke-linecap%3D%22round%22%20stroke-linejoin%3D%22round%22%20stroke-dasharray%3D%227%209%22%20fill%3D%22none%22%20marker-end%3D%22url(%23tailArrow)%22%2F%3E%3C%2Fsvg%3E",
              "className": "user-dashboard-empty-tail",
              "style": {
                "top": "calc(var(--dashboard-edit-anchor-top) + 27px)",
                "right": "calc(var(--dashboard-edit-anchor-right) + var(--dashboard-edit-anchor-width) - 22px)",
                "width": "224px"
              }
            },
            "allowLoadTemplate": true,
            "widgetDefinitionsApi": {
              "method": "get",
              "url": "/api/widget-definition"
            },
            "listTemplatesApi": {
              "method": "get",
              "url": "/api/user-dashboard-template/select"
            },
            "loadTemplateApi": {
              "method": "get",
              "url": "/api/user-dashboard-template/${id}/load"
            },
            "editable": true,
            "submitOnChange": true
          }
        ]
      }
    ]
  }
}
