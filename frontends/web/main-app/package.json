{
  "name": "ouroboros-web",
  "version": "2.0.0",
  "private": true,
  "scripts": {
    "serve": "node ./scripts/webpack-serve.js",
    "build": "node ./scripts/webpack-build.js",
    "build:report": "node ./scripts/webpack-build.js --report",
    "lint": "ESLINT_USE_FLAT_CONFIG=false eslint --ext .js,.jsx,.ts,.tsx src tests",
    "test": "npm run test:all",
    "test:unit": "vitest run",
    "test:integration:amis-editor": "playwright test --config=playwright.amis-editor.config.js",
    "test:integration:approval-workflow": "playwright test tests/integration/approval-workflow/approval-workflow-smoke.spec.js --config=playwright.config.js",
    "test:integration:business-model-populate": "playwright test tests/integration/business-model-populate/business-model-populate-smoke.spec.js --config=playwright.business-model-populate.config.js",
    "test:integration:modal-form-rendering": "playwright test --config=playwright.modal-form-rendering.config.js",
    "test:integration:amis-main-thread-performance": "node ./scripts/run-amis-main-thread-performance-local.js",
    "test:integration:amis-main-thread-performance:validate-artifacts": "node ./scripts/validate-amis-main-thread-performance-artifacts.js",
    "test:integration:input-table-overlay": "playwright test tests/integration/input-table-overlay/input-table-overlay-smoke.spec.js --config=playwright.input-table-overlay.config.js",
    "test:integration:main-app-layout-parity": "playwright test tests/integration/layout-parity --config=playwright.main-app-layout-parity.config.js --pass-with-no-tests",
    "test:integration:main-app-host-bootstrap": "playwright test tests/integration/main-app-host-bootstrap --config=playwright.main-app-host-bootstrap.config.js",
    "test:integration:main-app-host-e2e": "playwright test --config=playwright.main-app-host-e2e.config.js --pass-with-no-tests",
    "test:integration:organization-management": "playwright test --config=playwright.organization-management.config.js --pass-with-no-tests",
    "test:e2e:statistics-reporting:query": "playwright test tests/integration/statistics-reporting/statistics-reporting-dataset-editor.spec.js tests/integration/statistics-reporting/dataset-sql-editor.spec.js --config=playwright.statistics-reporting-runtime.config.js",
    "test:e2e:statistics-reporting:chart": "playwright test tests/integration/statistics-reporting/statistics-reporting-chart-editor.spec.js tests/integration/statistics-reporting/statistics-reporting-runtime.spec.js --config=playwright.statistics-reporting-runtime.config.js",
    "test:e2e:statistics-reporting:dashboard": "playwright test tests/integration/statistics-reporting/statistics-reporting-dashboard-editor.spec.js tests/integration/statistics-reporting/statistics-reporting-runtime.spec.js --config=playwright.statistics-reporting-runtime.config.js",
    "test:integration": "playwright test && npm run test:integration:main-app-layout-parity",
    "test:all": "npm run test:unit && npm run test:integration",
    "build:ouroboros": "node ./scripts/webpack-build.js ouroboros",
    "dev": "node ./scripts/webpack-serve.js",
    "start": "node ./scripts/webpack-serve.js",
    "publish-docker-image:aliyun": "node ./scripts/webpack-build.js && docker buildx build -t registry.cn-hangzhou.aliyuncs.com/ouroboros/ouroboros-web:latest . --push"
  },
  "dependencies": {
    "@fortawesome/fontawesome-free": "^6.4.0",
    "@stomp/stompjs": "^7.3.0",
    "amis": "^6.13.0",
    "amis-core": "^6.13.0",
    "amis-editor": "^6.13.0",
    "amis-editor-core": "^6.13.0",
    "amis-theme-editor-helper": "^2.0.27",
    "amis-ui": "^6.13.0",
    "axios": "^1.18.1",
    "copy-to-clipboard": "^3.3.3",
    "downshift": "^9.4.0",
    "jsonc-parser": "^3.3.1",
    "lodash": "^4.18.1",
    "mobx": "^4.15.7",
    "mobx-react": "^6.3.1",
    "mobx-state-tree": "^3.17.3",
    "monaco-editor-textmate": "^4.0.0",
    "monaco-textmate": "^3.0.1",
    "onigasm": "^2.2.5",
    "qiankun": "^2.10.16",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "react-grid-layout": "^1.5.3",
    "react-router-dom": "^6.30.4",
    "sockjs-client": "^1.6.1",
    "tree-like-object-utils": "^0.2.3",
    "tslib": "^2.8.1",
    "ouroboros-amis-runtime": "file:../ouroboros-amis-runtime",
    "file-saver": "^2.0.5",
    "moment": "^2.30.1",
    "react-intersection-observer": "^9.5.2",
    "react-resizable": "^3.0.5",
    "sortablejs": "^1.15.0",
    "yjs": "13.6.33"
  },
  "devDependencies": {
    "@babel/core": "^7.29.7",
    "@babel/eslint-parser": "^7.29.7",
    "@babel/plugin-proposal-decorators": "^7.29.7",
    "@babel/plugin-transform-class-properties": "^7.29.7",
    "@babel/plugin-transform-private-methods": "^7.29.7",
    "@babel/plugin-transform-private-property-in-object": "^7.29.7",
    "@babel/preset-env": "^7.29.7",
    "@babel/preset-react": "^7.29.7",
    "@babel/preset-typescript": "^7.29.7",
    "@playwright/test": "^1.61.1",
    "@types/lodash": "4.17.24",
    "@types/react": "^18.3.31",
    "@types/react-dom": "^18.3.7",
    "@types/sockjs-client": "^1.5.4",
    "@types/stompjs": "^2.3.10",
    "@typescript-eslint/eslint-plugin": "^8.64.0",
    "@typescript-eslint/parser": "^8.64.0",
    "assert": "^2.1.0",
    "autoprefixer": "^10.5.4",
    "babel-loader": "^9.2.1",
    "copy-webpack-plugin": "^13.0.1",
    "css-loader": "^7.1.2",
    "css-minimizer-webpack-plugin": "^7.0.2",
    "dotenv": "^16.6.1",
    "dotenv-expand": "^12.0.3",
    "eslint": "^9.39.5",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-jsx-a11y": "^6.10.2",
    "eslint-plugin-prettier": "^5.5.6",
    "eslint-plugin-react": "^7.37.5",
    "eslint-plugin-react-hooks": "^5.2.0",
    "html-webpack-deploy-plugin": "^3.0.0",
    "html-webpack-plugin": "^5.6.7",
    "https-browserify": "^1.0.0",
    "jsdom": "^29.1.1",
    "mini-css-extract-plugin": "^2.9.4",
    "monaco-editor-chinese-plugin": "^0.0.4",
    "monaco-editor-webpack-plugin": "^6.0.0",
    "path-browserify": "^1.0.1",
    "postcss": "^8.5.20",
    "postcss-loader": "^8.2.0",
    "prettier": "^3.9.5",
    "sass": "^1.101.0",
    "sass-loader": "^16.0.8",
    "stream-browserify": "^3.0.0",
    "stream-http": "^3.2.0",
    "style-loader": "^4.0.0",
    "svg-sprite-loader": "^6.0.11",
    "typescript": "^5.9.3",
    "url": "^0.11.0",
    "vitest": "^4.1.10",
    "webpack": "^5.108.4",
    "webpack-bundle-analyzer": "^4.10.1",
    "webpack-cli": "^7.2.1",
    "webpack-dev-server": "^6.0.0"
  }
}
